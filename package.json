{
  "name": "memosync",
  "productName": "memoSync",
  "version": "1.2.0",
  "description": "클라우드 폴더로 동기화되는 Windows용 반투명 포스트잇 메모",
  "main": "main/index.js",
  "author": "memoSync",
  "license": "MIT",
  "private": true,
  "scripts": {
    "start": "electron .",
    "test": "node --test",
    "test:e2e": "node e2e/run.js",
    "icons": "node scripts/make-icons.js",
    "build": "electron-builder --win nsis"
  },
  "build": {
    "appId": "com.memosync.app",
    "productName": "memoSync",
    "electronLanguages": [
      "ko",
      "en-US"
    ],
    "directories": {
      "output": "dist"
    },
    "files": [
      "main/**",
      "renderer/**",
      "assets/**",
      "preload.js",
      "!node_modules/@napi-rs/**",
      "!node_modules/pdfjs-dist/{build,web,image_decoders,types,wasm,iccs}/**",
      "!node_modules/pdfjs-dist/legacy/web/**",
      "!node_modules/pdfjs-dist/legacy/build/*.{map,d.mts}",
      "!node_modules/pdfjs-dist/legacy/build/*.min.mjs",
      "!node_modules/pdfjs-dist/legacy/build/pdf.{sandbox,renderer}.*"
    ],
    "win": {
      "target": "nsis",
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "memoSync"
    }
  },
  "dependencies": {
    "chokidar": "^4.0.3",
    "pdfjs-dist": "6.5.438"
  },
  "devDependencies": {
    "electron": "^45.2.1",
    "electron-builder": "^26.18.0",
    "playwright-core": "^1.64.1"
  }
}
